{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "AI Paints",
	"Version": "2.0.0.0",
	"Author": "Pascal Elou",
	"URL": "https://github.com/pascalelou/Stream-Deck-AI-Plugin",
	"Actions": [
		{
			"Name": "Generate",
			"UUID": "com.f00d4tehg0dz.aipaints.action",
			"Icon": "actions/template/assets/actionimage",
			"Tooltip": "Install me for AI Generative actions",
			"PropertyInspectorPath": "ui/inspector.html",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Push": "Generate a new Image",
					"Touch": "Generate a new Image"
				}
			},
			"States": [
				{
					"Image": "actions/template/assets/action"
				}
			]
		}
	],
	"Category": "AI Paints",
	"CategoryIcon": "actions/template/assets/category",
	"CodePath": "bin/plugin.js",
	"Description": "Generate images on Stream Deck with Cloudflare Workers AI and FLUX.2 Klein 4B.",
	"Icon": "actions/template/assets/action",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"UUID": "com.f00d4tehg0dz.aipaints"
}