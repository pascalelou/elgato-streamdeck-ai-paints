{
  "name": "stream-deck-ai-paints",
  "version": "2.0.0-rc.1",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "tsx --test test/**/*.test.ts",
    "build": "rollup -c",
    "validate": "streamdeck pack --dry-run src/com.f00d4tehg0dz.aipaints.sdPlugin",
    "pack": "streamdeck pack --force --output Release src/com.f00d4tehg0dz.aipaints.sdPlugin",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run validate"
  },
  "devDependencies": {
    "@elgato/cli": "1.9.0",
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "~24.1.0",
    "eslint": "^9.39.5",
    "rollup": "^4.63.3",
    "tslib": "^2.8.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2"
  }
}
